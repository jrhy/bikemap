# Copy to .env.local. These values are public and included in the static build.
# Required: a public pk.* Mapbox token authorized for your site's URL.
VITE_MAPBOX_TOKEN=

# Geographic dataset: chattanooga (default) or bend. This does not change branding.
VITE_CITY_ID=chattanooga

# Optional public base path. GitHub Actions sets /<repository>/ automatically.
# For local development or a custom domain leave this at /.
# BASE_PATH=/bikemap/
